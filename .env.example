# Variable NAMES only. Never put a value in this file — it is committed.
# Real values live in the Supabase Edge Function secret store, the Cloudflare
# Worker secret store, or the owner's local credential store.
# Source of truth: docs/SECURITY.md §6.

# ── Supabase ────────────────────────────────────────────────────────────────
# Public by design; RLS is the control, not secrecy.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses all RLS. Edge Function runtime ONLY. Never in a browser, never in a
# client-callable route, never in CI logs (CLAUDE.md R5).
SUPABASE_SERVICE_ROLE_KEY=
# A Postgres credential, NOT interchangeable with the service-role key. Used
# only by the owner's manual pg_dump. Never in any runtime.
SUPABASE_DB_PASSWORD=

# ── Credential encryption (docs/SECURITY.md §5) ─────────────────────────────
# 32 random bytes, base64. Edge Function runtime + two offline copies held by
# the owner, in separate locations. Losing it makes every stored credential
# permanently unrecoverable.
MASTER_KEY_V1=
# Present only during a rotation window, alongside V1.
MASTER_KEY_V2=

# ── Backups (ADR-013) ───────────────────────────────────────────────────────
# Public key: can only encrypt, so it is safe in the runtime. Integrity-
# sensitive — its fingerprint is logged on every export.
BACKUP_PUBLIC_KEY=
# NOTE: BACKUP_PRIVATE_KEY is deliberately absent. It must never be in any
# runtime or any file. Offline only, stored apart from MASTER_KEY_*.

# ── Watchdog (ARCHITECTURE.md ADR-003) ──────────────────────────────────────
WATCHDOG_TOKEN=

# ── Meta app (docs/API_INTEGRATIONS.md §3) ──────────────────────────────────
META_APP_ID=
# Used only for the server-side token exchange. Never in a browser.
META_APP_SECRET=
# Page access tokens are NOT environment variables: they are per-tenant and
# live encrypted in social_accounts.token_ciphertext.
