# ── Secrets: never commit ────────────────────────────────────────────────────
# CLAUDE.md §1.8 / SECURITY.md §6. .env.example (names only, empty values) is
# the one exception and is explicitly re-included below.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
secrets/
service-role*
master-key*

# Supabase local state and linked-project credentials
supabase/.temp/
supabase/.branches/
.supabase/

